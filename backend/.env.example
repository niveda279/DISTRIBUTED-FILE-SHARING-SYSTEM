# Backend Environment Variables
DATABASE_URL=postgresql+asyncpg://dfsuser:dfspassword@localhost:5432/dfsdb
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage Node URLs
NODE1_URL=http://localhost:8001
NODE2_URL=http://localhost:8002
NODE3_URL=http://localhost:8003

# File upload limits (bytes)
MAX_FILE_SIZE=104857600

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
